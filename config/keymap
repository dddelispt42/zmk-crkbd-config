                        bindings = <
DK URML(Q, W, E, R, T)        URMR(Y, U, I, O, P) DK
DK HRML(A, S, D, F) &kp G     &kp H HRMR(J, K, L, PT_C_CEDILLA) DK
DK LRML(Z, X, C, V) &kp B     &kp N LRMR(M, COMMA, DOT, PT_MINUS) DK
