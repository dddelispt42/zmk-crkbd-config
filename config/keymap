        // leaked a bare "c" and left Ctrl/Shift latched).
        combo_ctrlshiftx {
                  timeout-ms = <LONG_COMBO_TIMEOUT>;
                  key-positions = <4 5 6>;   // ONLY-FOR-CORNE
                  key-positions = <1 2 3>;   // ONLY-FOR-TEMPEST
                  key-positions = <1 2 3>;   // ONLY-FOR-SWEEP
                  require-prior-idle-ms = <200>;
                  layers = <QWERTY>;
                  bindings = <&kp LC(LS(X))>;
        };
        combo_ctrlshiftv {
                  timeout-ms = <LONG_COMBO_TIMEOUT>;
                  key-positions = <26 27 28>;  // ONLY-FOR-CORNE
                  key-positions = <21 22 23>;  // ONLY-FOR-TEMPEST
                  key-positions = <21 22 23>;  // ONLY-FOR-SWEEP
                  require-prior-idle-ms = <200>;
                  layers = <QWERTY>;
