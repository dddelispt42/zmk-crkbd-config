// Custom behaviours, hold-taps and the sticky-layer override.

// Upper row mods macro
#define URML(k1,k2,k3,k4,k5) &urm BLUETH k1  &urm MACROS k2  &urm MSOUTL k3  &urm WMCFG  k4  &urm MEDIA k5
#define URMR(k1,k2,k3,k4,k5) &urm MEDIA k1  &urm WMCFG  k2  &urm MSOUTL k3  &urm MACROS k4  &urm BLUETH k5
// Home row mods macro
#define HRML(k1,k2,k3,k4) &hm LGUI   k1  &hm LCTRL k2  &hm LALT  k3  &hms LSHIFT k4
#define HRMR(k1,k2,k3,k4) &hms RSHIFT k1  &hm LALT  k2  &hm LCTRL k3  &hm RGUI   k4
// Lower row mods macro
#define LRML(k1,k2,k3,k4) &kp k1  &hm RCTRL k2  &hm RALT  k3  &kp k4
#define LRMR(k1,k2,k3,k4) &kp k1  &hm RALT  k2  &hm RCTRL k3  &hm K_CMENU k4

&sl {
    release-after-ms = <1500>;
};


/ {
    behaviors {
        spc_ret: space_return {
            compatible = "zmk,behavior-mod-morph";
            #binding-cells = <0>;
            bindings = <&kp PT_SPACE>, <&kp RET>;
            mods = <(MOD_LALT)>;
        };
        bspc_del: backspace_delete {
            compatible = "zmk,behavior-mod-morph";
            #binding-cells = <0>;
            bindings = <&kp BACKSPACE>, <&kp DELETE>;
            mods = <(MOD_LSFT|MOD_RSFT)>;
            /*keep-mods = <(MOD_RSFT)>;*/
        };
        laquo_raquo: laquo_raquo {
            compatible = "zmk,behavior-mod-morph";
            #binding-cells = <0>;
            bindings = <&kp PT_LAQUO>, <&kp PT_RAQUO>;
            mods = <(MOD_LSFT|MOD_RSFT)>;
        };
        ordm_ordf: ordm_ordf {
            compatible = "zmk,behavior-mod-morph";
            #binding-cells = <0>;
            bindings = <&kp PT_ORDM>, <&kp PT_ORDF>;
            mods = <(MOD_LSFT|MOD_RSFT)>;
        };
        hm: homerow_mods {
            compatible = "zmk,behavior-hold-tap";
            #binding-cells = <2>;
            tapping-term-ms = <210>;
            require-prior-idle-ms = <150>;
            flavor = "tap-preferred";
            bindings = <&kp>, <&kp>;
        };
        hms: homerow_mod_shift {
            compatible = "zmk,behavior-hold-tap";
            #binding-cells = <2>;
            tapping-term-ms = <200>;
            require-prior-idle-ms = <125>;
            flavor = "balanced";
            bindings = <&kp>, <&kp>;
        };
        urm: upper_row_mods {
            compatible = "zmk,behavior-hold-tap";
            #binding-cells = <2>;
            tapping-term-ms = <250>;
            require-prior-idle-ms = <150>;
            flavor = "tap-preferred";
            bindings = <&mo>, <&kp>;
        };
        trm: thumb_row_mods {
            compatible = "zmk,behavior-hold-tap";
            #binding-cells = <2>;
            tapping-term-ms = <250>;
            require-prior-idle-ms = <50>;
            flavor = "tap-preferred";
            bindings = <&mo>, <&kp>;
         };
         skm: space_key_mod {  //TODO(heiko): not yet used
            compatible = "zmk,behavior-hold-tap";
            #binding-cells = <2>;
            tapping-term-ms = <250>;
            require-prior-idle-ms = <150>;
            flavor = "tap-preferred";
            /*bindings = <&mo>, <&spc_ret>;*/
            bindings = <&mo>, <&kp>;
        };
        unstick: unstick {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&kp LSHIFT &kp RSHIFT &kp LCTRL &kp RCTRL &kp LALT &kp RALT &kp LGUI &kp RGUI>;
        };
        capsw: behavior_caps_word {
            compatible = "zmk,behavior-caps-word";
            #binding-cells = <0>;
            continue-list = <BACKSPACE DELETE PT_MINUS PT_UNDER>;
        };
        // Leader key instances.
        //
        // leader1 is reached from the outermost left thumb on the 36-key boards
        // (LH2) and, on the 34-key sweep which has no LH2, from the LM4 LM3 LM2
        // chord - see combos.dtsi.
        // leader2 is reached from the N+M combo on every board.
        //
        // leader1 = the AHK replacement sequences (previously typed as "]xx").
        //           The leader key itself replaces the "]" prefix, so "]c"
        //           becomes leader1 then C.
        leader1: leader1 {
            compatible = "zmk,behavior-leader-key";
            #binding-cells = <0>;
            // Portuguese / English sign-offs
            cu  { sequence = <C U>;   bindings = <&m_sig_cumps>; };
            obr { sequence = <O B R>; bindings = <&m_sig_o>; };
            mo  { sequence = <M O>;   bindings = <&m_sig_mo>; };
            oc  { sequence = <O C>;   bindings = <&m_sig_oc>; };
            co  { sequence = <C O>;   bindings = <&m_sig_co>; };
            br  { sequence = <B R>;   bindings = <&m_sig_br>; };
            ty  { sequence = <T Y>;   bindings = <&m_sig_ty>; };
            tb  { sequence = <T B>;   bindings = <&m_sig_tb>; };
            th  { sequence = <T H>;   bindings = <&m_sig_th>; };
            yw  { sequence = <Y W>;   bindings = <&m_sig_yw>; };
            // MS Outlook headings (AHK "^b" = Ctrl-B)
            ag  { sequence = <A G>;   bindings = <&m_ag>; };
            obj { sequence = <O B J>; bindings = <&m_ob>; };
            ao  { sequence = <A O>;   bindings = <&m_ao>; };
            ac  { sequence = <A C>;   bindings = <&m_ac>; };
        };

        // leader2 = system / bluetooth sequences.
        leader2: leader2 {
            compatible = "zmk,behavior-leader-key";
            #binding-cells = <0>;
            usb { sequence = <U S B>; bindings = <&out OUT_USB>; };
            ble { sequence = <B L E>; bindings = <&out OUT_BLE>; };
            bt0 { sequence = <B N0>; bindings = <&bt BT_SEL 0>; };
            bt1 { sequence = <B N1>; bindings = <&bt BT_SEL 1>; };
            bt2 { sequence = <B N2>; bindings = <&bt BT_SEL 2>; };
            btc { sequence = <C L E A R>; bindings = <&bt BT_CLR>; };
            boot { sequence = <B O O T>; bindings = <&bootloader>; };
            reset { sequence = <R E S E T>; bindings = <&sys_reset>; };
        };
    };
};
