                )

        // Thank you and best regards, / Heiko
        ZMK_MACRO(m_sig_tb,
                wait-ms = <MACRO_WAIT>;
                tap-ms = <MACRO_TAP>;
        bindings = <&kp LS(T) &kp H &kp A &kp N &kp K &kp SPACE &kp Y &kp O
                    &kp U &kp SPACE &kp A &kp N &kp D &kp SPACE &kp B &kp E
                    &kp S &kp T &kp SPACE &kp R &kp E &kp G &kp A &kp R
                    &kp D &kp S &kp COMMA &kp RET &kp LS(H) &kp E &kp I &kp K
                    &kp O>;
                )

        // Thank you, / Heiko Riemer
