// Combos, written in zmk-helpers key labels.
//
// Positions are board-independent: LT4/LM0/LH1 resolve to
// whatever integer each keyboard's key-labels header assigns,
// so one definition serves corne/tempest/seppelit/sweep.
// Layer references are bare indices matching the order of the
// ZMK_LAYER definitions in layers.dtsi.

ZMK_COMBO(toggle_lock_left, &tog LOCK, LT4 LT0 LH0, 0 10, COMBO_TIMEOUT, 150)
ZMK_COMBO(toggle_lock_right, &tog LOCK, RT0 RT4 RH0, 0 10, COMBO_TIMEOUT, 150)
ZMK_COMBO(esc, &kp ESC, LT4 LT3, 0, COMBO_TIMEOUT, 120)
ZMK_COMBO(tab, &kp TAB, LM4 LM3, 0, COMBO_TIMEOUT, 120)
ZMK_COMBO(ret, &kp RET, RT0 RT1, 0, COMBO_TIMEOUT, 120)
ZMK_COMBO(capsword, &capsw, LM0 RM0, 0, SPLIT_COMBO_TIMEOUT, 200)
ZMK_COMBO(bspc, &kp BSPC, RM3 RM4, 0, COMBO_TIMEOUT, 150)
ZMK_COMBO(ctrlbspc, &kp LC(BSPC), RM1 RM2, 0, COMBO_TIMEOUT, 150)
ZMK_COMBO(del, &kp DEL, RT3 RT4, 0, COMBO_TIMEOUT, 150)
ZMK_COMBO(repeat_right, &key_repeat, RM0 RM1, 0, COMBO_TIMEOUT, 150)
ZMK_COMBO(sz, &kp RA(S), LB2 LB1, 0, COMBO_TIMEOUT, 100)
ZMK_COMBO(pup, &kp PG_UP, LT1 LT0, 0, COMBO_TIMEOUT, 150)
ZMK_COMBO(down, &kp PG_DN, LM1 LM0, 0, COMBO_TIMEOUT, 150)
ZMK_COMBO(prtwin, &kp PSCRN, LB4 LB3, 0, COMBO_TIMEOUT, 150)
ZMK_COMBO(ctrlshiftc, &kp LC(LS(C)), LM3 LM2 LM1, 0, LONG_COMBO_TIMEOUT, 200)
ZMK_COMBO(ctrlshiftx, &kp LC(LS(X)), LT3 LT2 LT1, 0, LONG_COMBO_TIMEOUT, 200)
ZMK_COMBO(ctrlshiftv, &kp LC(LS(V)), LB3 LB2 LB1, 0, LONG_COMBO_TIMEOUT, 200)
ZMK_COMBO(ctrl_a, &kp LC(A), RB1 RB2, 0, COMBO_TIMEOUT, 150)
ZMK_COMBO(ctrl_z, &kp LC(Z), RB2 RB3, 0, COMBO_TIMEOUT, 150)
ZMK_COMBO(leader2, &leader2, RB0 RB1, 0, COMBO_TIMEOUT, 150)

/*
 * num_word: T+Y starts a "number word".
 *
 * &num_word activates NUMNAV (layer index 1) and keeps it active while only
 * digits and the keys in the behavior's continue-list are pressed, dropping it
 * on any other key. That makes it a capsword for numbers: chord T+Y, type
 * 1234.56, and the layer releases itself when you go back to letters - no
 * separate key needed to leave it.
 *
 * The continue-list is the module default (BSPC DEL DOT COMMA PLUS MINUS STAR
 * FSLH EQUAL) plus all digits via `ignore-numbers`, so digits and the
 * separators keep it alive and everything else ends it.
 *
 * T (LT0) and Y (RT0) are the innermost key of each hand on the top row, so the
 * chord is comfortable and unlikely to fire while typing. It is free on all
 * four boards; the neighbouring LT1 LT0 and RT0 RT1 chords belong to pg_dn and
 * ret.
 */
ZMK_COMBO(num_word, &num_word 1, LT0 RT0, 0, SPLIT_COMBO_TIMEOUT, 200)

/*
 * Sweep only: reach &leader1 without a thumb key.
 *
 * The 36-key boards put &leader1 on LH2, the outermost left thumb. Sweep has
 * only four thumb keys, so that position does not exist and - because every
 * main key is bound on all twelve layers - there is no spare key to move it to.
 * A dedicated chord is therefore the only way to keep the leader key (and with
 * it the 43 signature/Outlook macros) reachable on sweep.
 *
 * LM4 LM3 LM2 is the outer three keys of the left home row; it is free on every
 * board (the neighbouring chords LM3 LM2 LM1 and LM2 LM1 LM0 are used by
 * ctrlshiftc and pg_dn respectively).
 */
#ifdef ZMK_KB_34
ZMK_COMBO(leader1, &leader1, LM4 LM3 LM2, 0, LONG_COMBO_TIMEOUT, 200)
#endif

/*
 * Vulgar fractions, on NUMNAV digit pairs.
 *
 * The digits on NUMNAV are N1..N0 left to right, i.e. keys LT4 LT3 LT2 LT1 LT0
 * | RT0 RT1 RT2 RT3 RT4. Chording the two digits that name the fraction gives
 * the single Unicode character: 1+2 -> ½, 3+4 -> ¾, 1+4 -> ¼, and so on.
 *
 * All of these are NUMNAV-only (layer 1). That is what makes them safe despite
 * sharing keys with layer-0 combos - ½ uses LT4 LT3 like esc, ⅘ uses LT0 LT1
 * like pup, ⅚ uses LT0 RT0 like num_word. ZMK gates a combo by the active
 * layer (`layer_mask` in combo.c), so a NUMNAV combo cannot fire on QWERTY.
 *
 * These are the 19 vulgar fractions Unicode defines; there is no ½-family
 * beyond ½ and no fraction for pairs like 2+2, so the set is closed.
 *
 * SPLIT_COMBO_TIMEOUT and a high prior-idle guard are used because these are
 * two-finger chords on adjacent keys, which are easier to hit by accident than
 * the three-finger chords elsewhere in this file.
 */
ZMK_COMBO(frac_1_2, &uc UC_VULGAR_FRACTION_ONE_HALF,     LT4 LT3, 1, SPLIT_COMBO_TIMEOUT, 200)
ZMK_COMBO(frac_1_4, &uc UC_VULGAR_FRACTION_ONE_QUARTER,  LT4 LT1, 1, SPLIT_COMBO_TIMEOUT, 200)
ZMK_COMBO(frac_3_4, &uc UC_VULGAR_FRACTION_THREE_QUARTERS, LT2 LT1, 1, SPLIT_COMBO_TIMEOUT, 200)
ZMK_COMBO(frac_1_3, &uc UC_VULGAR_FRACTION_ONE_THIRD,    LT4 LT2, 1, SPLIT_COMBO_TIMEOUT, 200)
ZMK_COMBO(frac_2_3, &uc UC_VULGAR_FRACTION_TWO_THIRDS,   LT3 LT2, 1, SPLIT_COMBO_TIMEOUT, 200)
ZMK_COMBO(frac_0_3, &uc UC_VULGAR_FRACTION_ZERO_THIRDS,  RT4 LT2, 1, SPLIT_COMBO_TIMEOUT, 200)
ZMK_COMBO(frac_1_5, &uc UC_VULGAR_FRACTION_ONE_FIFTH,    LT4 LT0, 1, SPLIT_COMBO_TIMEOUT, 200)
ZMK_COMBO(frac_2_5, &uc UC_VULGAR_FRACTION_TWO_FIFTHS,   LT3 LT0, 1, SPLIT_COMBO_TIMEOUT, 200)
ZMK_COMBO(frac_3_5, &uc UC_VULGAR_FRACTION_THREE_FIFTHS, LT2 LT0, 1, SPLIT_COMBO_TIMEOUT, 200)
ZMK_COMBO(frac_4_5, &uc UC_VULGAR_FRACTION_FOUR_FIFTHS,  LT1 LT0, 1, SPLIT_COMBO_TIMEOUT, 200)
ZMK_COMBO(frac_1_6, &uc UC_VULGAR_FRACTION_ONE_SIXTH,    LT4 RT0, 1, SPLIT_COMBO_TIMEOUT, 200)
ZMK_COMBO(frac_5_6, &uc UC_VULGAR_FRACTION_FIVE_SIXTHS,  LT0 RT0, 1, SPLIT_COMBO_TIMEOUT, 200)
ZMK_COMBO(frac_1_7, &uc UC_VULGAR_FRACTION_ONE_SEVENTH,  LT4 RT1, 1, SPLIT_COMBO_TIMEOUT, 200)
ZMK_COMBO(frac_1_8, &uc UC_VULGAR_FRACTION_ONE_EIGHTH,   LT4 RT2, 1, SPLIT_COMBO_TIMEOUT, 200)
ZMK_COMBO(frac_3_8, &uc UC_VULGAR_FRACTION_THREE_EIGHTHS, LT2 RT2, 1, SPLIT_COMBO_TIMEOUT, 200)
ZMK_COMBO(frac_5_8, &uc UC_VULGAR_FRACTION_FIVE_EIGHTHS, LT0 RT2, 1, SPLIT_COMBO_TIMEOUT, 200)
ZMK_COMBO(frac_7_8, &uc UC_VULGAR_FRACTION_SEVEN_EIGHTHS, RT1 RT2, 1, SPLIT_COMBO_TIMEOUT, 200)
ZMK_COMBO(frac_1_9, &uc UC_VULGAR_FRACTION_ONE_NINTH,    LT4 RT3, 1, SPLIT_COMBO_TIMEOUT, 200)
ZMK_COMBO(frac_1_0, &uc UC_VULGAR_FRACTION_ONE_TENTH,    LT4 RT4, 1, SPLIT_COMBO_TIMEOUT, 200)
